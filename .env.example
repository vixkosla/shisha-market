# Local mode works without Docker. PGlite is for development, not deployment.
APP_URL=http://127.0.0.1:4387
# Set false for a public infrastructure preview without accepting accounts.
AUTH_ENABLED=true
# Deferred wiki notes/bookmarks/read marks. Hidden unless explicitly enabled.
WIKI_NOTEBOOK_ENABLED=false
# Production remains closed until operator, data processing and markets are reviewed.
# These fields are PUBLIC legal information, not secrets. Never invent details.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=hello@shisha-market.com
LEGAL_DATA_LOCATION=
LEGAL_PROCESSORS=
LEGAL_RETENTION=
LEGAL_APPROVED_MARKETS=[]
LEGAL_PUBLIC_READY=false
DB_DRIVER=pglite
PGLITE_PATH=.data/postgres
MAIL_MODE=console
# Required for production; generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Production: DB_DRIVER=postgres, MAIL_MODE=smtp, APP_URL=https://your-domain
DATABASE_URL=postgresql://shisha:change-me@127.0.0.1:5487/shisha
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Shisha Market <hello@shisha-market.com>
# Public analytics of shisha-market.com: Metrika counter and GA4 web stream.
# The old counter 29210670 stays with shisha-market.ru.
METRIKA_COUNTER_ID=113672611
GA_MEASUREMENT_ID=G-E9YMQQ5CXW
YANDEX_METRIKA_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
# Community key with wall + photos rights. Both values enable autoposting;
# leave empty to keep it off. VK_GROUP_ID is the numeric community id.
VK_GROUP_TOKEN=
VK_GROUP_ID=
# Local MCP / operator HTTP. Unset in production until the token is installed.
OPERATOR_TOKEN=
# Credentials are retained for future setup; VK ID is currently disabled in code.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Generated parts of the home page live search. Any OpenAI-compatible URL, e.g.
# https://openrouter.ai/api/v1 or a rented Ollama at http://127.0.0.1:11434/v1.
# Leave empty: search still works from the wiki and listings, without generated text.
LIVE_LLM_URL=
# Chosen 2026-11-10 on real site questions: qwen/qwen3.7-flash, about $0.03 per 1000 answers. No GPU server is needed.
LIVE_LLM_MODEL=
LIVE_LLM_KEY=
LIVE_LLM_MAX_ACTIVE=4
LIVE_LLM_DAILY_LIMIT=1000
