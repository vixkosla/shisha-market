{
  "name": "shisha-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4387",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4387",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "user:role": "tsx scripts/set-role.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/tektur": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "nodemailer": "10.0.15",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
