    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "vite": "8.3.5",
