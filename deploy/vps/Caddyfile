{
	admin 127.0.0.1:2019
	servers {
		protocols h1 h2
		max_header_size 32KB
		timeouts {
			read_header 10s
			read_body 60s
			idle 2m
		}
	}
}

https://SERVER_IP {
	# An explicit public ACME issuer overrides the default internal IP CA.
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow, noarchive"
	@operator path /api/operator/* /api/member/*
	@other not path /api/operator/* /api/member/*
	request_body @operator {
		max_size 12MiB
	}
	request_body @other {
		max_size 9MB
	}
	reverse_proxy 127.0.0.1:4387
}
