[Unit]
Description=Shisha Market HTTPS reverse proxy
Requires=shisha-egress.service
After=shisha-egress.service shisha-market.service

[Service]
Type=notify
User=shisha-caddy
Group=shisha-caddy
Environment=XDG_DATA_HOME=/var/lib/shisha-caddy
Environment=XDG_CONFIG_HOME=/var/lib/shisha-caddy
ExecStart=/opt/shisha-market/bin/caddy run --environ --config /etc/shisha-market/Caddyfile
ExecReload=/opt/shisha-market/bin/caddy reload --config /etc/shisha-market/Caddyfile
Restart=on-failure
RestartSec=5
UMask=0077
MemoryMax=256M
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/shisha-caddy
BindReadOnlyPaths=/etc/shisha-market/resolv.conf:/etc/resolv.conf
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# IPv6 on this shared host belongs to the VPN. Use the site's IPv4 egress only.
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=multi-user.target
